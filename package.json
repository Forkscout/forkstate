{
  "name": "forkstate",
  "version": "0.1.0",
  "type": "module",
  "description": "A fork that does not copy \u2014 mainnet state read through on demand, writes kept in an overlay.",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "start:bun": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=60000 test/suite.ts",
    "test:bun": "bun test --timeout 60000 ./test/suite.ts",
    "docker": "docker build -t forkstate ."
  },
  "dependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@noble/hashes": "^2.4.0",
    "postgres": "^3.4.9",
    "solc": "^0.8.36"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "keywords": [
    "ethereum",
    "evm",
    "fork",
    "testnet",
    "anvil",
    "devnet",
    "rpc",
    "tracing"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ]
}
